{
  "schema_version": 1,
  "phase": "4-standards-seed",
  "baseline": "phases/baselines/3-provider-model-ui.json",
  "policy": {
    "context_mode": "contract-first",
    "frozen_after_completion": true,
    "default_read_order": [
      "baseline",
      "module-map",
      "public-contracts",
      "current-step",
      "targeted-implementation-only-if-needed"
    ]
  },
  "modules": [
    {
      "name": "contracts",
      "owner_steps": [0],
      "owned_paths": [
        "phases/4-standards-seed/*",
        "phases/project-manifest.json"
      ],
      "contracts": [
        "phases/4-standards-seed/module-map.json"
      ],
      "dependencies": [],
      "status": "planned"
    },
    {
      "name": "seed-json-files",
      "owner_steps": [1],
