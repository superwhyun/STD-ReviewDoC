      "owner_steps": [2],
      "owned_paths": [
        "lib/storage/seed-loader.ts",
        "components/seed-initializer.tsx",
        "app/layout.tsx",
        "app/admin/page.tsx"
      ],
      "contracts": [
        "lib/storage/seed-loader.ts",
        "components/seed-initializer.tsx",
